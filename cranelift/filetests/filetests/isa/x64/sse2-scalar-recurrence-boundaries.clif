test compile precise-output
set opt_level=speed
set regalloc_checker=true
target x86_64

;; The outer parameter is reused in every inner iteration. The product
;; must keep accumulating in the inner parameter's register.
function %nested(f64, f64, i64, i64) -> f64 {
block0(v0: f64, v1: f64, v2: i64, v3: i64):
    v12 = iconst.i64 1
    jump block1(v0, v2)
block1(v4: f64, v5: i64):
    jump block2(v1, v3)
block2(v6: f64, v7: i64):
    v8 = fadd v6, v6
    v9 = fmul v8, v4
    v10 = isub v7, v12
    brif v10, block2(v9, v10), block3
block3:
    v11 = isub v5, v12
    brif v11, block1(v9, v11), block4
block4:
    return v9
}

